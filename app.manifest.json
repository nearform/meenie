{
  "display_information": {
    "name": "meenie",
    "description": "Pick someone at random from a channel or a custom list.",
    "background_color": "#1f2937",
    "long_description": "meenie picks team members at random from Slack channels or your own custom lists. Use it to choose who handles a task, leads a meeting, or makes the next coffee. Combine with Slack's /remind to automate picks."
  },
  "features": {
    "bot_user": {
      "display_name": "meenie",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/meenie",
        "url": "https://REPLACE_ME.ngrok-free.app/slack/events",
        "description": "Pick someone at random. Try /meenie help.",
        "usage_hint": "pick #channel | list create my-team | stats @my-team",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://REPLACE_ME.ngrok-free.app/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:read",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE_ME.ngrok-free.app/slack/events",
      "bot_events": []
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://REPLACE_ME.ngrok-free.app/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
