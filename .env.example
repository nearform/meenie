# Copy this file to `.env` and fill in the empty values.
# `.env` is gitignored; never commit real secrets.

# ── App ──────────────────────────────────────────────────────────────────────

# HTTP port the server binds to. Must match the port published in docker-compose.yml.
PORT=3000

# Public URL the Slack app reaches. Use your ngrok HTTPS URL during development
# (e.g. https://abcd-1234.ngrok-free.app); use your real domain in production.
APP_BASE_URL=http://localhost:3000

# Node environment. `production` in containers, `development` locally.
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────

# Postgres connection string. Defaults align with the `db` service in
# docker-compose.yml. When running under compose, the app overrides the host
# portion to `db` automatically.
DATABASE_URL=postgres://meeny:meeny@localhost:5432/meeny

# ── Slack ────────────────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps after importing app.manifest.json.

# Used to verify request signatures from Slack.
SLACK_SIGNING_SECRET=

# OAuth client credentials (Basic Information -> App Credentials).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Random 32+ char string used to sign OAuth `state` cookies.
# Generate one with: `openssl rand -hex 32`
SLACK_STATE_SECRET=change-me-to-a-long-random-string

# Single-workspace dev shortcut: bot token (xoxb-…) of the workspace you
# installed the app into. In multi-workspace mode this is provided per
# request via the installation store and may be left blank.
SLACK_BOT_TOKEN=

# ── Optional tooling ─────────────────────────────────────────────────────────

# ngrok auth token, required only for the `tunnel` compose profile
# (`docker compose --profile tunnel up`). Get one at
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
