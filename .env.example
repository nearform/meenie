# Copy to .env and fill in. Do not commit .env.

# Fastify HTTP port
PORT=3000

# Public URL the Slack app can reach (use ngrok in dev, e.g. https://xxxx.ngrok-free.app)
APP_BASE_URL=http://localhost:3000

# Postgres (matches docker-compose.yml service "db" in P3a)
DATABASE_URL=postgres://meeny:meeny@localhost:5432/meeny

# Slack app credentials. Get these from https://api.slack.com/apps after importing app.manifest.json.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Random 32+ char string used to sign OAuth `state` cookies.
SLACK_STATE_SECRET=change-me-to-a-long-random-string

# Single-workspace dev shortcut: bot token of the workspace you installed the app into.
# In multi-workspace mode this is provided per request via the installation store.
SLACK_BOT_TOKEN=
